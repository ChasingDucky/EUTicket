# Wiki.js Environment Configuration
# Copy this file to .env.wiki and customize the values

# Database Password
# IMPORTANT: Change this to a strong random password in production!
DB_PASSWORD=wikijspassword

# Wiki.js Configuration
# Generate a random session secret with: openssl rand -base64 32
SESSION_SECRET=change-me-to-random-string

# Optional: Email Configuration (for user registration/notifications)
# MAIL_SERVICE=gmail
# MAIL_FROM=noreply@euticketwiki.com
# MAIL_USER=your-email@gmail.com
# MAIL_PASS=your-app-password

# Optional: Public URL (if hosting online)
# PUBLIC_URL=https://euticketwiki.com
